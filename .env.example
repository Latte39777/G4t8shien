# 環境変数のテンプレート。実際の値は .env.local に置く（.gitignore 対象・コミット禁止）。
# 注意: API キーはサーバ専用。フロントエンド（クライアント）へ露出しないこと。
#       NEXT_PUBLIC_ プレフィックスを付けてはいけない（クライアントに露出するため）。

# ── AI相談（M6）: INIAD API（大学提供 OpenAI 互換 API / chat.completions） ──
# 2 重スイッチ: CONSULT_LIVE_AI=1 かつ INIAD_API_KEY 設定の両方そろわない限り
# Live AI は無効（M5 のモック応答のまま）。G2 承認前はどちらも設定しないこと。
CONSULT_LIVE_AI=0
# INIAD_API_KEY=（大学発行の API キー。サーバ専用・コミット禁止）

# 確認済みの接続情報（変更しないこと）
CONSULT_API_BASE_URL=https://api.openai.iniad.org/api/v1
CONSULT_MODEL=gpt-5.4

# 1 リクエストの応答待ち上限（ms）
CONSULT_TIMEOUT_MS=30000

# Live 利用中の通信障害時の挙動:
#   0 = エラー表示＋再試行（既定・安全側）
#   1 = モック応答にフォールバック（「モック応答に切り替えました」と明示する）
CONSULT_FALLBACK_TO_MOCK=0

# AI 能力フラグ（大学 API で未確認の機能は利用不可）
# CONSULT_AI_SEARCH: off（既定）以外は設定不可（web_search は能力未確認）
CONSULT_AI_SEARCH=off
# CONSULT_AI_JSON_MODE: prompt（既定・プロンプトで JSON を要求して zod 検証）| off
#   （structured outputs は能力未確認のため利用不可）
CONSULT_AI_JSON_MODE=prompt

# 質問の最大文字数（1〜1000）
CONSULT_MAX_QUESTION_CHARS=1000

# レート制限（暫定値。大学 API の上限確認後に要調整）
# ※メモリ実装のため開発・単一インスタンス専用。本番公開前に永続化が必要（未解決事項）
CONSULT_RATE_LIMIT_RPM=10
CONSULT_RATE_LIMIT_PER_DAY=100
CONSULT_RATE_LIMIT_GLOBAL_PER_MIN=30

# プロキシ信頼設定（クライアント IP 単位のレート制限用）
# Route Handler から TCP 接続元 IP は取得できないため、既定では
# X-Forwarded-For を信用せず全リクエストを共有バケットで制限する。
# 「全トラフィックが信頼できるプロキシ経由である」ことを運用で保証できる
# 構成でのみ CONSULT_TRUST_PROXY=1 にすること（それ以外では偽装され得る）。
CONSULT_TRUST_PROXY=0
CONSULT_TRUSTED_PROXY_HOPS=1